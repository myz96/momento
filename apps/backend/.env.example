# Cloudflare R2 object storage. With all four set, media lands in R2;
# otherwise files go to local disk (MOMENTO_MEDIA_DIR, default data/media).
# Copy to .env (gitignored) and fill in from the Cloudflare dashboard:
# R2 -> Manage API Tokens -> Create API Token (Object Read & Write).
MOMENTO_R2_ACCOUNT_ID=
MOMENTO_R2_ACCESS_KEY_ID=
MOMENTO_R2_SECRET_ACCESS_KEY=
MOMENTO_R2_BUCKET=momento-media
